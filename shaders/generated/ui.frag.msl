#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_UiStyle
{
    float4 tint;
    float4 options;
};

struct main0_out
{
    float4 out_var_SV_Target0 [[color(0)]];
};

struct main0_in
{
    float2 in_var_TEXCOORD0 [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_UiStyle& UiStyle [[buffer(0)]], texture2d<float> font_atlas [[texture(0)]], sampler font_sampler [[sampler(0)]])
{
    main0_out out = {};
    out.out_var_SV_Target0 = float4(UiStyle.tint.xyz, UiStyle.tint.w * mix(1.0, font_atlas.sample(font_sampler, in.in_var_TEXCOORD0).x, UiStyle.options.x));
    return out;
}
